PORT=4100
NODE_ENV=development
LOG_LEVEL=info

# Postgres - required. Holds the notifications ledger (prisma/schema.prisma).
# Create the database, then: npm run db:deploy
DATABASE_URL=postgresql://notification:notification@localhost:5432/notification

# Kafka - required. Comma-separated broker list.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-service
# Comma-separated topics to consume.
KAFKA_TOPICS=auth.events,hospital.events
# Messages that can never succeed are parked here instead of blocking the topic.
KAFKA_DLQ_TOPIC=notification.dlq
# Managed Kafka (MSK, Confluent Cloud...) - TLS and SASL. Leave empty locally.
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# SMTP - optional outside production. With no SMTP_HOST the service runs in
# "log" mode: it renders each email and logs it instead of sending (fine for
# local dev with no mail server, and for CI). NODE_ENV=production refuses to
# start without SMTP_HOST. Point SMTP_HOST/PORT at Mailpit (see
# docker-compose.yml) to actually see delivered mail locally.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Uyir <no-reply@uyir.test>"
