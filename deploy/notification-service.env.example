# Copy to /opt/notification-service/shared/notification-service.env on the EC2
# host and fill in. chmod 640, owned by the deploy user / notification-service
# group (setup-ec2.sh does this). NEVER commit the real file.

NODE_ENV=production
PORT=4100
LOG_LEVEL=info

# --- Postgres ----------------------------------------------------------------
# The notifications ledger. Amazon RDS for PostgreSQL in the same VPC; its
# security group must allow this instance on 5432. Migrations run on every
# deploy (remote-release.sh), so the user needs CREATE on the database.
DATABASE_URL="postgresql://notification:CHANGE_ME@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/notification?sslmode=require"

# --- Kafka -------------------------------------------------------------------
# Must be reachable from this host: an MSK / Confluent / self-hosted broker in
# the same VPC. The security group must allow this instance on the broker port.
KAFKA_BROKERS=b-1.your-cluster.kafka.ap-south-1.amazonaws.com:9096,b-2.your-cluster.kafka.ap-south-1.amazonaws.com:9096
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-service
KAFKA_TOPICS=auth.events,hospital.events
# Messages that can never succeed (bad payload, mailbox doesn't exist) are
# parked here instead of blocking the topic. Create it up front if the cluster
# has auto.create.topics.enable=false.
KAFKA_DLQ_TOPIC=notification.dlq

# TLS + SASL. MSK with SASL/SCRAM: port 9096, scram-sha-512. Plaintext
# self-hosted broker in a private subnet: KAFKA_SSL=false, leave SASL empty.
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- SMTP (required in production) -------------------------------------------
# Amazon SES: SES console -> SMTP settings -> "Create SMTP credentials".
# The sending domain must be verified in SES (which publishes DKIM), the account
# must be out of the SES sandbox, and the domain needs SPF + DMARC records.
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Uyir <no-reply@uyirhealthapp.com>"
